/* QGarage Dark Theme */

* {
    font-family: "Segoe UI", "Inter", "Roboto", -apple-system, BlinkMacSystemFont, sans-serif;
}

#qgarageDashboard {
    background-color: #1a1a24;
}

/* Toolbar area */
#qgarageToolbar {
    background-color: #1a1a24;
    border-bottom: 1px solid #2a2a38;
    padding: 10px 12px;
}

/* Action buttons in toolbar */
#qgarageInstallButton, #qgarageNewAppButton, #qgarageSettingsButton {
    background-color: #4a9d6f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 500;
    font-size: 11px;
}
#qgarageInstallButton:hover, #qgarageNewAppButton:hover, #qgarageSettingsButton:hover {
    background-color: #5bb382;
}
#qgarageInstallButton:pressed, #qgarageNewAppButton:pressed, #qgarageSettingsButton:pressed {
    background-color: #3a7d5f;
}

/* Card grid scroll area */
#qgarageCardArea {
    background-color: #1a1a24;
    border: none;
}

/* Individual app cards */
.AppCardWidget {
    background-color: #242430;
    border: 1px solid #2f2f3d;
    border-radius: 8px;
}
.AppCardWidget:hover {
    border-color: #4a9d6f;
    background-color: #2a2a34;
}

/* Toolbox cards */
.ToolboxCardWidget {
    background-color: #242430;
    border: 1px solid #2f2f3d;
    border-radius: 10px;
}
.ToolboxCardWidget[expanded="true"] {
    border-color: #4a6ba0;
}
#toolboxHeader {
    background-color: transparent;
    border-radius: 10px;
}
#toolboxHeader:hover {
    background-color: rgba(255, 255, 255, 0.03);
}
#toolboxCardTitle {
    color: #f0f2f5;
    font-size: 13px;
    font-weight: 600;
}
#toolboxCardDescription {
    color: #a8adb8;
    font-size: 11px;
}
#toolboxCountBadge {
    background-color: #3a5478;
    color: #e8eef8;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 500;
}
QToolButton#toolboxExpandButton {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid #3a3a48;
    border-radius: 16px;
    padding: 0;
}
QToolButton#toolboxExpandButton:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: #4a5a70;
}
QToolButton#toolboxExpandButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}
#toolboxAppsContainer {
    background-color: rgba(0, 0, 0, 0.15);
    border-top: 1px solid rgba(255, 255, 255, 0.03);
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* Card title */
#appCardTitle {
    color: #f0f2f5;
    font-size: 13px;
    font-weight: 600;
}

/* Card description */
#appCardDescription {
    color: #a8adb8;
    font-size: 11px;
}

/* State badges */
#appStateBadge {
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    color: white;
    font-weight: 500;
}

/* Card run button */
#appCardRunButton {
    background-color: #4a9d6f;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
    font-weight: 500;
    font-size: 11px;
}
#appCardRunButton:hover {
    background-color: #5bb382;
}
#appCardRunButton:disabled {
    background-color: #4a4a58;
    color: #7a7a88;
}

/* App host header */
#appHeader {
    font-size: 16px;
    font-weight: 600;
    color: #f0f2f5;
    margin-bottom: 4px;
}

#appDescription {
    color: #a8adb8;
    font-size: 11px;
}

/* Run button inside app view */
#appRunButton {
    background-color: #4a9d6f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 500;
    font-size: 12px;
}
#appRunButton:hover {
    background-color: #5bb382;
}
#appRunButton:disabled {
    background-color: #4a4a58;
    color: #7a7a88;
}

/* Output area */
#appOutputArea {
    background-color: #1a1a24;
    color: #c0c0c8;
    border: 1px solid #2f2f3d;
    border-radius: 4px;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 11px;
    padding: 8px;
}

/* Back button */
#qgarageBackButton {
    background-color: transparent;
    color: #a8adb8;
    border: 1px solid #2f2f3d;
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 11px;
}
#qgarageBackButton:hover {
    color: #f0f2f5;
    border-color: #4a5a70;
}

/* Progress bar */
QProgressBar {
    background-color: #2a2a34;
    border: 1px solid #2f2f3d;
    border-radius: 4px;
    text-align: center;
    color: #e0e0e8;
    font-size: 10px;
}
QProgressBar::chunk {
    background-color: #4a9d6f;
    border-radius: 3px;
}

/* Labels */
QLabel {
    color: #f0f2f5;
}

/* Group box */
QGroupBox {
    color: #d0d0d8;
    border: 1px solid #2f2f3d;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 12px;
    font-weight: 500;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}
