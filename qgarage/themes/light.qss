/* QGarage Light Theme */

* {
    font-family: "Segoe UI", "Inter", "Roboto", -apple-system, BlinkMacSystemFont, sans-serif;
}

#qgarageDashboard {
    background-color: #fafbfc;
}

/* Toolbar area */
#qgarageToolbar {
    background-color: #fafbfc;
    border-bottom: 1px solid #e5e8ec;
    padding: 10px 12px;
}

/* Action buttons in toolbar */
#qgarageInstallButton, #qgarageMarketplaceButton, #qgarageNewAppButton, #qgarageSettingsButton {
    background-color: #4a9d6f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 500;
    font-size: 11px;
}
#qgarageInstallButton:hover, #qgarageMarketplaceButton:hover, #qgarageNewAppButton:hover, #qgarageSettingsButton:hover {
    background-color: #5bb382;
}
#qgarageInstallButton:pressed, #qgarageMarketplaceButton:pressed, #qgarageNewAppButton:pressed, #qgarageSettingsButton:pressed {
    background-color: #3a7d5f;
}

/* Card grid scroll area */
#qgarageCardArea {
    background-color: #fafbfc;
    border: none;
}

/* Individual app cards */
.AppCardWidget {
    background-color: #ffffff;
    border: 1px solid #e5e8ec;
    border-radius: 8px;
}
.AppCardWidget:hover {
    border-color: #4a9d6f;
    background-color: #f9fafb;
}

/* Toolbox cards */
.ToolboxCardWidget {
    background-color: #ffffff;
    border: 1px solid #e5e8ec;
    border-radius: 10px;
}
.ToolboxCardWidget[expanded="true"] {
    border-color: #7fa6c8;
}
#toolboxHeader {
    background-color: transparent;
    border-radius: 10px;
}
#toolboxHeader:hover {
    background-color: #f5f7fa;
}
#toolboxCardTitle {
    color: #1a1d2e;
    font-size: 13px;
    font-weight: 600;
}
#toolboxCardDescription {
    color: #5a6570;
    font-size: 11px;
}
#toolboxCountBadge {
    background-color: #e3ecf8;
    color: #2b4a6a;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 500;
}
QToolButton#toolboxExpandButton {
    background-color: #f3f5f7;
    border: 1px solid #d8dce3;
    border-radius: 16px;
    padding: 0;
}
QToolButton#toolboxExpandButton:hover {
    background-color: #ecf1f6;
    border-color: #9fb0c5;
}
QToolButton#toolboxExpandButton:pressed {
    background-color: #e5eaf2;
}
#toolboxAppsContainer {
    background-color: #f9fafb;
    border-top: 1px solid #e8ecf0;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* Card title */
#appCardTitle {
    color: #1a1d2e;
    font-size: 13px;
    font-weight: 600;
}

/* Card description */
#appCardDescription {
    color: #5a6570;
    font-size: 11px;
}

/* State badges */
#appStateBadge {
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    color: white;
    font-weight: 500;
}

/* Card run button */
#appCardRunButton {
    background-color: #4a9d6f;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
    font-weight: 500;
    font-size: 11px;
}
#appCardRunButton:hover {
    background-color: #5bb382;
}
#appCardRunButton:disabled {
    background-color: #d5d8dd;
    color: #8a8d92;
}

/* App host header */
#appHeader {
    font-size: 16px;
    font-weight: 600;
    color: #1a1d2e;
    margin-bottom: 4px;
}

#appDescription {
    color: #5a6570;
    font-size: 11px;
}

/* Run button inside app view */
#appRunButton {
    background-color: #4a9d6f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 500;
    font-size: 12px;
}
#appRunButton:hover {
    background-color: #5bb382;
}
#appRunButton:disabled {
    background-color: #d5d8dd;
    color: #8a8d92;
}

/* Output area */
#appOutputArea {
    background-color: #f5f6f8;
    color: #2a2d35;
    border: 1px solid #e5e8ec;
    border-radius: 4px;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 11px;
    padding: 8px;
}

/* Back button */
#qgarageBackButton {
    background-color: transparent;
    color: #5a6570;
    border: 1px solid #e5e8ec;
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 11px;
}
#qgarageBackButton:hover {
    color: #1a1d2e;
    border-color: #a0aab8;
}

/* Progress bar */
QProgressBar {
    background-color: #e8ecf1;
    border: 1px solid #e5e8ec;
    border-radius: 4px;
    text-align: center;
    color: #2a2d35;
    font-size: 10px;
}
QProgressBar::chunk {
    background-color: #4a9d6f;
    border-radius: 3px;
}

/* Labels */
QLabel {
    color: #1a1d2e;
}

/* Group box */
QGroupBox {
    color: #3a3d45;
    border: 1px solid #e5e8ec;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 12px;
    font-weight: 500;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}
